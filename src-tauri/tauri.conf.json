{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Score Studio",
  "version": "0.2.3",
  "identifier": "com.scorestudio.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Score Studio · 曲谱工坊",
        "width": 1020,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "center": true,
        "backgroundColor": "#16130e",
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "resources": {
      "../sheet_pipeline.py": "sheet_pipeline.py",
      "../library_ops.py": "library_ops.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "曲谱标准化工坊",
    "longDescription": "从多源链接与本地文件提取曲谱，统一为 2009px·300DPI·白底 PDF。"
  }
}
